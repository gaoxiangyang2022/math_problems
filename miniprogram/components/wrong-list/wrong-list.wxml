<view class="completion-banner">
  <view class="completion-title">{{wrongList.length ? '本次练习完成' : '本次全对，真棒！'}}</view>
  <view>这次做了 {{sessionTotal}} 道，答对 {{sessionCorrect}} 道</view>
</view>
<view class="stats">
  <view><text class="stats-num">{{stats.total}}</text><text> 累计做题</text></view>
  <view><text class="stats-num wrong">{{stats.wrong}}</text><text> 累计错题</text></view>
  <view><text class="stats-num good">{{stats.total - stats.wrong}}</text><text> 累计答对</text></view>
</view>
<button class="clear-stats-btn" size="mini" bindtap="clearStats">清空今日统计</button>
<view wx:if="{{wrongList.length>0}}">
  <view class="title">{{emojiStr[0]}} 一起把这些题弄明白</view>
  <scroll-view type="list"
  scroll-y style="height: 65vh;">
    
    <view class="questions-wrapper">
      <block wx:for="{{wrongList}}" wx:key="index">
        <view class="question-card">
            <text class="question-content">{{item.question}} = {{item.correctAnswer}}</text>
            <text class="your-answer">你的答案：{{item.yourAnswer}}</text>
            <button class="demo-btn" size="mini" data-item="{{item}}" bindtap="goDemo">看演示</button>
        </view>
      </block>
    </view>
  </scroll-view>
</view>
<view wx:if="{{wrongList.length==0}}">
  <view class="relative">
      <view class="confetti"></view>
  </view>
        
  <view style="text-align: center;">
    <h1 class="animate-bounce" bind:tap="changeEmlji">太棒了！</h1>
    <view >{{guli[0]}}</view>
    
    <view class="good-job">
        <view class="good-job-item">
            <view class="item-icon item-c1">{{emojiStr[2]}}</view>
            <p >完美表现</p>
        </view>
        <view class="good-job-item">
            <view class="item-icon item-c2">{{emojiStr[3]}}</view>
            <p >满分成就</p>
        </view>
        <view class="good-job-item">
            <view class="item-icon item-c3">{{emojiStr[4]}}</view>
            <p>庆祝时刻</p>
        </view>
      </view>
    </view>
</view>
<button class="restart-btn" type="primary" bindtap="restart">再练一次</button>
<demo-anim
  visible="{{demoVisible}}"
  question="{{demoQuestion}}"
  correctAnswer="{{demoAnswer}}"
  bind:close="closeDemo"
></demo-anim>
