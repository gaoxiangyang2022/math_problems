<app-nav title="加减混合"></app-nav>
<view style="width: 100%;">
  <!-- 选择界面 -->
  <view wx:if="{{showWherePage==0}}" class="container select-page">

    <range-total bind:beginTest="startTest" bind:beginPrint="beginPrint"></range-total>
  </view>

  <!-- 做题界面 -->
  <view wx:if="{{showWherePage==1}}" class="container practice-page">
    
    <progress-bar index="{{currentIndex}}" total="{{currentTotal}}" wrongNum="{{wrongQuestions.length}}"></progress-bar>
    <practice-settings mode="manual" showVerify="{{false}}" delay="{{debounce_time}}" autoNext="{{autoNext}}" checked="{{answerChecked}}" bind:change="changePracticeSettings" bind:verify="checkAnswer" bind:next="nextProblem"></practice-settings>
    
    <view id="feedback">{{feedbackMessage}}</view>
    <view class="problem {{errorShake? ' shake' : ''}}">
      <view id="problem">{{currentProblem}}</view>
      <view class="question-ans">
       <view class="answer-box {{userAnswer !== '' ? 'filled' : ''}}" bindtap="clearAnswer">{{userAnswer || '?'}}</view>
      </view>
    </view>
    <view class="keypad-dock">
      <number-keypad bind:digit="inputDigit" bind:backspace="backspaceDigit" bind:clear="clearAnswer"></number-keypad>
    </view>
  </view>
 <!-- 错题本区域 -->
 <view wx:if="{{showWherePage==2}}" class="container">
    <wrong-list wrongList="{{wrongQuestions}}" sessionTotal="{{currentTotal}}" bind:restart="restartQuiz"></wrong-list>
 </view>

 <!-- 打印题展示界面 -->
<view wx:if="{{showWherePage==3}}" class="container">
 
 <print-view problemList="{{problemList}}" column="2" pcolumn="3" rowGap="1" bind:beginPrint="beginPrint"></print-view>
</view>

</view>
