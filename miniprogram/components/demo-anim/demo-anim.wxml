<view class="mask" wx:if="{{visible}}">
  <view class="panel">
    <view class="panel-head">
      <text class="title">{{title}}</text>
      <text class="close" bindtap="close">×</text>
    </view>
    <canvas id="demoCanvas" canvas-id="demoCanvas" class="canvas"></canvas>
    <view wx:if="{{mode !== 'unsupported'}}" class="step-text">
      <text wx:if="{{stepIndex === 0}}">点击“下一步”，跟着步骤一起算</text>
      <text wx:if="{{stepIndex > 0}}">{{steps[stepIndex - 1].title}}：{{steps[stepIndex - 1].detail}}</text>
    </view>
    <view class="actions">
      <button wx:if="{{mode !== 'unsupported'}}" type="primary" bindtap="nextStep" disabled="{{stepIndex >= steps.length}}">{{stepIndex >= steps.length ? '演示完成' : '下一步'}}</button>
      <button wx:if="{{mode !== 'unsupported'}}" bindtap="reset">重置</button>
      <button bindtap="close">关闭</button>
    </view>
  </view>
</view>
