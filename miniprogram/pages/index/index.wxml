<!--index.wxml-->
<view class="page">

   <!-- 顶部标题 -->
   <view class="header">
        <view class="welcome-copy">
          <view class="eyebrow">今天的小任务</view>
          <view class="title">想先练哪一关？</view>
          <view class="subtitle">{{encouragement}}</view>
        </view>
        <view class="study-buddies">
          <view class="buddy main-buddy" bind:tap="goAboutFun">{{emo1}}</view>
          <view class="buddy {{animalMove == 2 ? 'animal-move' : ''}}" bind:tap="emojiClick" data-index="2">{{emo2}}</view>
          <view class="buddy {{animalMove == 3 ? 'animal-move' : ''}}" bind:tap="emojiClick" data-index="3">{{emo3}}</view>
          <view class="buddy {{animalMove == 4 ? 'animal-move' : ''}}" bind:tap="emojiClick" data-index="4">{{emo4}}</view>
        </view>
    </view>

    <view class="continue-card" wx:if="{{lastPractice && lastPractice.url}}" bind:tap="goLastPractice">
      <view class="continue-label">继续上次练习</view>
      <view class="continue-title">{{lastPractice.title}}</view>
      <view class="continue-action">接着来一小关</view>
    </view>

    <!-- 主要内容区域 -->
    <view class="lesson-group">
      <view class="group-title">入门热身</view>
      <view class="grid">
        <view class="card warm-card" bind:tap="goToSimpleAddSub">
            <view class="card-tag easy-tag">入门</view>
            <view class="icon">+−</view>
            <view class="card-text">
              <view class="card-title">简单加减法</view>
              <view class="card-des">先热热身</view>
            </view>
        </view>
        <view class="card mint-card" bind:tap="goToMult">
            <view class="card-tag easy-tag">入门</view>
            <view class="icon">×</view>
            <view class="card-text">
              <view class="card-title">乘法口算</view>
              <view class="card-des">小步快算</view>
            </view>
        </view>
      </view>
    </view>

    <view class="lesson-group">
      <view class="group-title">竖式挑战</view>
      <view class="grid">
        <view class="card blue-card" bind:tap="goToAddSub">
            <view class="card-tag practice-tag">练习</view>
            <view class="icon">12+</view>
            <view class="card-text">
              <view class="card-title">加减竖式</view>
              <view class="card-des">排整齐来算</view>
            </view>
        </view>
        <view class="card rose-card" bind:tap="goMulEquationFun">
            <view class="card-tag challenge-tag">挑战</view>
            <view class="icon">12×</view>
            <view class="card-text">
              <view class="card-title">乘法竖式</view>
              <view class="card-des">一步一步乘</view>
            </view>
        </view>
      </view>
    </view>

    <view class="lesson-group">
      <view class="group-title">小技巧</view>
      <view class="grid">
        <view class="card pink-card" bind:tap="goToMultip">
            <view class="card-tag skill-tag">技巧</view>
            <view class="icon">口诀</view>
            <view class="card-text">
              <view class="card-title">乘法口诀</view>
              <view class="card-des">边念边记</view>
            </view>
        </view>
        <view class="card yellow-card" bind:tap="goTotenFun">
            <view class="card-tag video-tag">视频课</view>
            <view class="icon">10</view>
            <view class="card-text">
              <view class="card-title">凑、破10法</view>
              <view class="card-des">找一找 10</view>
            </view>
        </view>
      </view>
    </view>

    <view class="lesson-group">
      <view class="group-title">进阶挑战</view>
      <view class="grid">
        <view class="card amber-card" bind:tap="goToMixAdd">
            <view class="card-tag challenge-tag">挑战</view>
            <view class="icon">±</view>
            <view class="card-text">
              <view class="card-title">加减混合</view>
              <view class="card-des">认真看符号</view>
            </view>
        </view>
        <view class="card purple-card" bind:tap="goToMixMultip">
            <view class="card-tag challenge-tag">挑战</view>
            <view class="icon">×±</view>
            <view class="card-text">
              <view class="card-title">加减乘混合</view>
              <view class="card-des">升级小挑战</view>
            </view>
        </view>
      </view>
    </view>
    
    <!-- 底部 -->
    <view class="footer">
        快乐学习 · 天天进步
    </view>
</view>
