<view class="page">
  <view class="hero">
    <view class="hero-title">乘法口诀乐园</view>
    <view class="hero-subtitle">先选一个数字，再一条一条看口诀</view>
  </view>

  <view class="number-tabs">
    <button
      wx:for="{{tableNums}}"
      wx:key="item"
      class="number-tab {{selectedBase == item ? 'active' : ''}}"
      data-base="{{item}}"
      bindtap="selectBase"
    >{{item}}</button>
  </view>

  <view class="study-card">
    <view class="card-head">
      <view>
        <view class="card-title">{{selectedBase}} 的乘法口诀</view>
        <view class="card-subtitle">点击一条，看看它表示多少组</view>
      </view>
      <view class="card-badge">{{selectedFacts.length}} 条</view>
    </view>

    <view class="facts-grid">
      <view
        wx:for="{{selectedFacts}}"
        wx:key="index"
        class="fact-card {{showExplanation && selectedIndex == index ? 'active' : ''}}"
        data-index="{{index}}"
        bindtap="showFactExplanation"
      >
        <view class="fact-main">{{item.t}}</view>
        <view class="fact-tip">{{item.i}} 组，每组 {{item.j}} 个</view>
      </view>
    </view>
  </view>

  <view class="explanation-panel" wx:if="{{showExplanation}}">
    <view class="explanation-head">
      <view>
        <view class="explanation-header">{{explanationHeader}}</view>
        <view class="explanation-text">{{explanationText}}</view>
      </view>
      <button class="close-btn" bindtap="closeExplanation">×</button>
    </view>

    <scroll-view type="list" scroll-x enable-flex show-scrollbar="{{false}}" class="animal-scroll" scroll-with-animation="true" scroll-left="{{scrollLeft}}">
      <view class="animals-container">
        <view class="animal-group" wx:for="{{groupData}}" wx:key="index">
          <view class="animal-row">
            <view wx:for="{{item}}" wx:key="index" class="{{item.label ? 'group-label' : 'animal-item'}}">{{item.t}}</view>
          </view>
        </view>
      </view>
    </scroll-view>

    <view class="panel-actions">
      <button class="nav-btn" bindtap="prevFact" disabled="{{selectedIndex == 0}}">上一条</button>
      <button class="nav-btn primary" bindtap="nextFact" disabled="{{selectedIndex >= selectedFacts.length - 1}}">下一条</button>
    </view>
  </view>
</view>
