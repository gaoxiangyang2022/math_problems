<app-nav title="加减竖式"></app-nav>
<view>
<!-- 选择界面 -->
<view wx:if="{{showWherePage==0}}" class="container select-page">
  <range-total bind:beginTest="startTest" range="{{false}}"  bind:beginPrint="beginPrint" ></range-total>
</view>

  <view wx:if="{{showWherePage==1}}" class="container practice-page">

    <progress-bar index="{{currentIndex}}" total="{{currentTotal}}" wrongNum="{{wrongQuestions.length}}"></progress-bar>
       
    <view id="feedback">{{feedbackMessage}}</view>
        <!-- 竖式计算区域 -->
        <view class="vertical-equation">
            <!--计算动画演示 -->
           

            <!--数字1 -->
            <view class="number-row">
                <view wx:for="{{num1Array}}" wx:key="index" class="digit-cell {{index==num1Selected?'selected':''}}"  >{{item}}</view>
            </view>
            
            <!-- 数字2 -->
            <view class="number-row">
                <!-- 计算符号 -->
                <view class="digit-cell operator">{{operator}}</view>
                <view wx:for="{{num2Array}}" wx:key="index" class="digit-cell {{index==num2Selected ? 'selected' : '' }}"  >{{item}}</view>
            </view>
            
            <!-- 横线 -->
            <view class="line"></view>
            
            <!-- 结果输入区域（逆向排列） -->
            <view class="result-inputs {{errorShake? ' shake' : ''}}">
                <view
                  wx:for="{{correctAnswerArray}}"
                  wx:key="index"
                  class="result-input {{inputFocus==index ? 'focus' : ''}} {{userAnswerArray[index] !== null ? 'filled' : ''}}"
                  data-index="{{index}}"
                  bindtap="selectInputCell"
                >
                  <text wx:if="{{userAnswerArray[index] !== null}}">{{userAnswerArray[index]}}</text>
                  <text wx:else class="placeholder">{{['个','十','百','千','万'][index]}}</text>
                </view>
            </view>
        </view>

      <view class="keypad-dock">
        <number-keypad
          bind:digit="inputDigit"
          bind:backspace="backspaceDigit"
          bind:clear="clearDigits"
        ></number-keypad>
      </view>


	</view>

 <!-- 错题本区域 -->
  <view wx:if="{{showWherePage==2}}" class="container">
    <wrong-list wrongList="{{wrongQuestions}}" sessionTotal="{{currentTotal}}" bind:restart="restartQuiz"></wrong-list>
  </view>

  <!-- 打印题展示界面 -->
<view wx:if="{{showWherePage==3}}" class="container">
  <print-view problemList="{{problemList}}" column="1" pcolumn="3" rowGap="4" bind:beginPrint="beginPrint"></print-view>
</view>


</view>
